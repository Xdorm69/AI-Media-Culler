 src/media_culler/cache.py      | 28 ++++++++++++++++++
 src/media_culler/pipeline.py   | 42 +++++++++++++--------------
 src/media_culler/scanner.py    | 42 +++++++++++++++++++++++----
 tests/test_incremental_scan.py | 53 ++++++++++++++++++++++++++++++++++
 5 files changed, 152 insertions(+), 29 deletions(-)
