+
+# ----------------------------------------------------------------------- scoring rules
+def scene(**kw) -> SceneMetrics:
+    base = dict(
+        horizon=HorizonInfo(angle_deg=0.0, y=1 / 3, confidence=0.9),
+        highlight_clip=0.0,
+        shadow_clip=0.0,
+        dynamic_range=200.0,
+        sharpness_focus=400.0,
+        saliency_x=1 / 3,
+        saliency_y=1 / 3,
+    )
